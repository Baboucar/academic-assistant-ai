# Node
node_modules/
**/node_modules/

# Build outputs
dist/
build/
coverage/
.vite/
.cache/

# SQLite databases
tmp/*.db
tmp/*.db-*
tmp/*.db-shm
tmp/*.db-wal

# Logs
logs/
*.log
*.log.*

# Env files
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db

# Timetable and notice files stay local: they can name staff and are not for publishing.
# Put your own files in data/ and run the ingest; nothing in data/ is committed.
data/*
!data/.gitkeep

# accounts database and backups (never commit)
var/
backups/

# evaluation results saved while comparing runs
tmp/*.json
# production settings (the example file next to it is kept)
deploy/.env.production
