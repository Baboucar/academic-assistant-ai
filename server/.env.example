# Copy to server/.env and fill in. (For a Docker deployment use deploy/.env.production.example instead.)
# `npm run dev` starts in development mode and only warns about what is missing.
# `npm start` starts in production mode and refuses to start until the settings are safe.

# ---- The AI model ----
# Required: Groq API key (the free tier is enough to try it) — https://console.groq.com/keys
GROQ_API_KEY=
MODEL=openai/gpt-oss-120b
# Optional: any OpenAI-compatible endpoint (defaults to Groq)
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# Seconds a repeated first question is answered from memory (0 turns this off)
# ANSWER_CACHE_SECONDS=600

# ---- Admins ----
# Required for the admin dashboard. In production each password must be 12+ characters.
ADMIN_USER=admin
ADMIN_PASS=
# More admins, each with their own password, so the change log shows who did what:
# (a password here cannot contain a comma)
# ADMIN_USERS=awa:a long password,lamin:another long password

# ---- Student accounts ----
# Sign-up emails a 6-digit code, which needs an email server (SMTP). Required in production.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<an app password>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=UTG Academic Assistant <you@example.com>
# Emails per day, to one address and in total (Gmail allows about 500 a day). Sign-ups may use
# at most 80% of the total, so password resets keep working during a flood of fake sign-ups.
# MAIL_PER_ADDRESS_PER_DAY=8
# MAIL_PER_DAY=400
# Sign-up, resend and reset requests per network address per hour
# MAIL_PER_NETWORK_PER_HOUR=120
# Which email addresses may sign up (comma-separated), and what a matriculation number looks like
# STUDENT_EMAIL_DOMAINS=utg.edu
# MAT_NUMBER_PATTERN=^[A-Z0-9]{5,12}$
# Set to 1 if student addresses contain the matriculation number (22216789@...): the two must then agree
# MAT_IN_EMAIL=1
# Local testing only, when SMTP is not set up: show the code on the sign-up screen instead of emailing it
# DEV_SHOW_CODES=1
# Questions each student may ask
# CHAT_PER_MINUTE=10
# CHAT_PER_DAY=150
# Sign-up/sign-in requests per network address in 15 minutes (high: a campus shares one address)
# AUTH_PER_15_MIN=3000

# ---- The website ----
# Which sites may call the API: "*" (development only) or a comma-separated list of origins
ORIGIN=*
# Timezone used for "today", "tomorrow" and "next class"
TIMEZONE=Africa/Banjul
# Set to 1 when running behind a reverse proxy (Caddy, nginx, Render, ...)
# TRUST_PROXY=1
# PORT=5051

# ---- Where data is kept ----
# Leave these out to use the folders inside the repository: data/, tmp/utg.db, var/accounts.db, backups/.
# To keep them elsewhere, give full paths (a relative path is taken from the folder the server is started in).
# Uploaded timetable files
# DATA_DIR=/srv/utg-assistant/data
# What was read from them; can be rebuilt from DATA_DIR at any time
# DB_PATH=/srv/utg-assistant/db/utg.db
# Student accounts, settings and logs; CANNOT be rebuilt, so back it up
# ACCOUNTS_DB_PATH=/srv/utg-assistant/accounts/accounts.db
# Where `npm run backup` puts dated copies of both databases, and how many of each to keep
# BACKUP_DIR=/srv/utg-assistant/backups
# BACKUP_KEEP=14
