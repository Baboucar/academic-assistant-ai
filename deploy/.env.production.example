# Settings for the API on a real server.
#
#   cp deploy/.env.production.example deploy/.env.production
#   chmod 600 deploy/.env.production
#
# deploy/.env.production holds secrets. It is listed in deploy/.gitignore:
# never commit it, and never paste it into a chat or an issue.
#
# How to write values (so the same file works with Docker and with systemd):
#   - one NAME=value per line, no spaces around "="
#   - comments on their own line only, never after a value
#   - if a value contains spaces or any of  $ # " \  put it in single quotes
#     (and do not use a single quote inside the value):
#       ADMIN_PASS='correct horse $battery staple'
#
# In production the server refuses to start, and says why in its log, unless
# the settings marked REQUIRED are filled in.


# ---- AI model ---------------------------------------------------------------

# REQUIRED. Groq API key: https://console.groq.com/keys
# The free tier is enough to try things out, not for a whole campus
# (see "Capacity" in README.md).
GROQ_API_KEY=

# The model that writes the answers.
MODEL=openai/gpt-oss-120b

# Optional: another OpenAI-compatible provider instead of Groq.
# GROQ_BASE_URL=https://api.groq.com/openai/v1


# ---- Website address --------------------------------------------------------

# REQUIRED. The address students type, with https:// and no "/" at the end.
# "*" is refused in production. Several addresses: separate them with commas.
# If the web app is on Netlify, this is the Netlify address (or your own
# domain there), not the API's address.
ORIGIN=https://assistant.example.edu

# Leave at 1: the API sits behind Caddy, and this lets rate limits see each
# visitor's real address instead of Caddy's.
TRUST_PROXY=1


# ---- Admin sign-in ----------------------------------------------------------

# REQUIRED: at least one admin. Every admin password must be 12 characters or
# longer. Use a long random one, for example from:  openssl rand -base64 24
ADMIN_USER=admin
ADMIN_PASS=

# Optional: more admins, each with their own password, so the admin log shows
# who changed what. Format: name:password,name:password
# (so these passwords cannot contain a comma).
# ADMIN_USERS='awa:a long password,lamin:another long password'


# ---- Email (sign-up and password-reset codes) ---------------------------------

# REQUIRED. The mail server that sends the six-digit codes.
# Use port 587 or 465. Many cloud providers, Oracle Cloud included, block
# outgoing port 25.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<the address>,
# SMTP_PASS=<an app password, not the account password>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM='UTG Academic Assistant <no-reply@example.edu>'

# Most emails sent in a day: to one address, and in total.
# MAIL_PER_ADDRESS_PER_DAY=8
# MAIL_PER_DAY=400
# Sign-up, resend and reset requests per network address per hour
# MAIL_PER_NETWORK_PER_HOUR=120

# Must stay off on a real server (the server refuses to start with it on).
# DEV_SHOW_CODES=


# ---- Student accounts -------------------------------------------------------

# Email domains that may sign up, separated by commas.
STUDENT_EMAIL_DOMAINS=utg.edu

# What a matriculation number looks like.
MAT_NUMBER_PATTERN='^[A-Z0-9]{5,12}$'

# Set to 1 if student addresses contain the matriculation number
# (22216789@utg.edu): sign-up then requires the two to agree.
# MAT_IN_EMAIL=1


# ---- Limits -----------------------------------------------------------------

# Questions each student may ask.
# CHAT_PER_MINUTE=10
# CHAT_PER_DAY=150

# How long an answer is reused when the same question is asked again
# (first question of a chat only). 0 turns this off.
# ANSWER_CACHE_SECONDS=600

# Sign-up and sign-in requests from one network address in 15 minutes.
# A whole campus can share one address, so this is high on purpose.
# AUTH_PER_15_MIN=3000


# ---- Time -------------------------------------------------------------------

# Used for "today", "tomorrow" and "next class".
TIMEZONE=Africa/Banjul


# ---- Where data is stored ---------------------------------------------------
#
# WITH DOCKER: leave this whole block commented out. The image already points
# these at /app/state/..., where docker-compose.yml mounts the volumes.
# Setting them here would put the data outside the volumes and it would be
# lost when the container is replaced.
#
# WITHOUT DOCKER (systemd): uncomment and keep them outside the git checkout.
#
# Uploaded timetable files. Keep.
# DATA_DIR=/var/lib/utg-assistant/data
# Timetable database. Can be rebuilt from DATA_DIR.
# DB_PATH=/var/lib/utg-assistant/db/utg.db
# Student accounts, sessions, admin settings and logs. Cannot be rebuilt.
# ACCOUNTS_DB_PATH=/var/lib/utg-assistant/accounts/accounts.db
# Where "npm --prefix server run backup" writes its copies.
# BACKUP_DIR=/var/lib/utg-assistant/backups

# How many backups of each database to keep.
# BACKUP_KEEP=14

# Port the API listens on. Caddy expects 5051.
# PORT=5051
